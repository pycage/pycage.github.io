                selection: 0
            }
        }

        Box {
            margins: 4
            fillWidth: true
            height: theme.itemHeightMedium
            layout: "center-row"

            Label {
                fillWidth: true
                text: "Ray Marching Depth: " + canvas.marchingDepth
            }

            Slider {
                id: marchingDepthSlider

                fillWidth: true
                minValue: 1
                maxValue: 128
                stepSize: 1
                value: 64
            }
        }

        Box {
            margins: 4
            fillWidth: true
            height: theme.itemHeightMedium
            layout: "center-row"

            Label {
                fillWidth: true
                text: "Ray Tracing Depth: " + canvas.tracingDepth
            }

            Slider {
                id: tracingDepthSlider

                fillWidth: true
                minValue: 1
                maxValue: 32
                stepSize: 1
                value: 16
            }
        }

        Box {
            margins: 4
            fillWidth: true
            height: theme.itemHeightMedium
            layout: "center-row"

            Label {
                fillWidth: true
                text: "Fog Density: " + Math.floor(fogDensitySlider.seekValue)
            }

            Slider {
                id: fogDensitySlider

                fillWidth: true
                minValue: 0
                maxValue: 256
                stepSize: 1
                value: 0
            }
        }

        Box {
            margins: 4
            fillWidth: true
            height: theme.itemHeightMedium
            layout: "center-row"

            Label {
                fillWidth: true
                text: "TASM"
            }

            Switch {
                id: tasmCheckBox

                checked: true
            }
        }

        Box {
            margins: 4
            fillWidth: true
            height: theme.itemHeightMedium
            layout: "center-row"

            Label {
                fillWidth: true
                text: "Compute Shadows"
            }

            Switch {
                id: shadingCheckBox

                checked: true
            }
        }

        Box {
            margins: 4
            fillWidth: true
            height: theme.itemHeightMedium
            layout: "center-row"

            Label {
                fillWidth: true
                text: "Toon Effect"
            }

            Switch {
                id: toonEffectCheckBox

                checked: false
            }
        }
    }

    Label {
        position: "free"
        origin: "top-right"
        x: theme.paddingSmall
        y: theme.paddingSmall
        fontSize: 24
        color: "red"
        text: "[" + canvas.cameraLocation.flat().map(l => l.toFixed(1)).join(", ") + "] " +
              canvas.originalWidth + "x" + canvas.originalHeight +
              " " + Math.floor(fpsMeter.fps) + " FPS"
    }

    Label {
        position: "free"
        origin: "bottom-left"
        x: theme.paddingSmall
        y: theme.paddingSmall
        fontSize: 24
        color: "white"
        text: gamePad.connected ? gamePad.name + " connected"
                                : "WASD: move/rotate Q/E: strafe Wheel: look up/down"
    }

    Timer {
        interval: 1000.0 / 60.0
        running: canvas.keysPressed.size > 0
        repeat: true

        onTimeout: () =>
        {
            canvas.keysPressed.values().forEach(canvas.handleKey);
        }
    }

    /*
    SequentialAction {
        repeat: true

        onInitialization: () =>
        {
            start();
        }

        NumberAnimation {
            duration: 3000
            from: 0.0
            to: 90.0

            onNext: value =>
            {
                world.data[world.objectSize * world.rotatingGlass + 3] = value;
            }
        }

        NumberAnimation {
            duration: 3000
            from: 90.0
            to: 0.0

            onNext: value =>
            {
                world.data[world.objectSize * world.rotatingGlass + 3] = value;
            }
        }

    }
    */

    Timer {
        interval: 50
        repeat: true
        running: true

        onTimeout: () =>
        {
            if (sekai.worldData.size === 0)
            {
                // not ready yet
                return;
            }

            // check for falling
            const feetLoc = mat.add(canvas.cameraLocation, mat.vec(0.0, -2.01, 0.0));
            if (isLocationFree(feetLoc) && ! gEngine.running)
            {
                gEngine.force = 0;
                gEngine.running = true;
            }
        }
    }

    FrameTimer {
        fps: 60
        repeat: true
        running: true

        onTimeout: now =>
        {
            canvas.setUniform("int", "timems", Math.floor(now * 1000));
            canvas.setUniform("float", "msaaLevel", [0, 2, 4, 8, 16][msaaSelector.selection]);
            canvas.setUniform("float", "screenWidth", canvas.originalWidth);
            canvas.setUniform("float", "screenHeight", canvas.originalHeight);
            canvas.setUniform("int", "enableTasm", tasmCheckBox.checked);
            canvas.setUniform("int", "enableShadows", shadingCheckBox.checked);
            canvas.setUniform("float", "fogDensity", fogDensitySlider.seekValue / 256.0);
            canvas.invalidateCanvas();
        }
    }
}
